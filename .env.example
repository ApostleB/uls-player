DATA_DIR=./data
MEDIA_DIR=./media

OUTPUT_FORMATS=mp3,wav

MP3_BITRATE=192k
MP3_SAMPLE_RATE=44100
MP3_CHANNELS=2
# LAME 인코딩 알고리즘 정밀도(0~9, 클수록 빠르고 덜 정밀). 비워 두면
# 인코더 기본값을 쓴다. 7이면 mp3 인코딩이 약 2.2배 빠르다(3분 40초
# 녹음 기준 1.78초 → 0.81초). 192kbps에서는 귀로 구분하기 어렵다.
# MP3_COMPRESSION_LEVEL=7

WAV_CODEC=pcm_s16le
WAV_SAMPLE_RATE=44100
WAV_CHANNELS=1

CONVERT_CONCURRENCY=4
WAVEFORM_PEAKS=2000
MAX_UPLOAD_MB=500
MAX_UPLOAD_TOTAL_MB=4096

# --- 배포(adapter-node)에서만 필요한 값 ---
# 개발 서버(npm run dev)에서는 없어도 된다.

# 실제 접속 주소. 리버스 프록시 뒤에서는 서버가 스스로 알 수 없어서
# 지정해야 한다 — 빠뜨리면 SvelteKit의 CSRF 검사가 form POST를 전부
# 403으로 막는다(가져오기 저장, 일괄 내려받기).
ORIGIN=http://localhost:3000

# adapter-node의 요청 본문 한도(바이트). 기본값 512KB라 이걸 안 올리면
# 업로드가 첫 파일부터 막힌다. 위 MAX_UPLOAD_TOTAL_MB와 맞춘다(4096MB).
# 다만 실질적인 상한은 서버 RAM이다 — 업로드는 바디 전체를 메모리에
# 올린 뒤에야 처리된다.
BODY_SIZE_LIMIT=4294967296
